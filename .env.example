# ─── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── OpenAI ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ─── Pinecone ──────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=

# ─── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── WhatsApp (UazAPI) ─────────────────────────────────────────
UAZAPI_BASE_URL=https://seu-servidor-uazapi.com
UAZAPI_TOKEN=
UAZAPI_INSTANCE=

# ─── Google TTS (Chirp3-HD + Neural2) ─────────────────────────
# APIs & Services → Credenciais → Criar chave de API → Cloud Text-to-Speech API
GOOGLE_TTS_API_KEY=

# ─── Gemini TTS (expressividade máxima + markup tags) ──────────
# aistudio.google.com/app/apikey  ou  console.cloud.google.com
# Requer ffmpeg instalado no servidor para converter PCM → OGG_OPUS
# Deixe vazio para usar apenas Chirp3-HD (fallback automático)
GEMINI_API_KEY=

# ─── Asaas Pagamentos ──────────────────────────────────────────
ASAAS_API_KEY=
ASAAS_SANDBOX=

# ─── Resend (e-mail) ───────────────────────────────────────────
RESEND_API_KEY=

# ─── Telegram Bot ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─── JWT (Super Admin) ─────────────────────────────────────────
JWT_SECRET=

# ─── Servidor ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=https://app.cranios.pro,https://api.cranios.pro

# ─── Puppeteer (VPS) ───────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
